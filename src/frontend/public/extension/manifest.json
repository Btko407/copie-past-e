{
  "manifest_version": 3,
  "name": "Copie Past-e Smart Post",
  "version": "1.3.0",
  "description": "Auto-fill marketplace listings from Copie Past-e. Manual posting only.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.mercari.com/*",
    "https://www.ebay.com/*",
    "https://poshmark.com/*",
    "https://www.depop.com/*",
    "https://www.etsy.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/create/*"],
      "js": ["content-facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.mercari.com/sell/*"],
      "js": ["content-mercari.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ebay.com/*"],
      "js": ["content-ebay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://poshmark.com/*"],
      "js": ["content-poshmark.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.depop.com/*"],
      "js": ["content-depop.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.etsy.com/*"],
      "js": ["content-etsy.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "web_accessible_resources": [
    { "resources": ["*.png"], "matches": ["<all_urls>"] }
  ]
}
